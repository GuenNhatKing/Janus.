# Mẫu cấu hình an toàn — copy thành .env rồi điền giá trị thực.
# .env và local/neondb.txt đều nằm trong .gitignore; không commit hai file này.

# Chuỗi kết nối Neon Postgres lấy từ local/neondb.txt ở thư mục gốc repo,
# ví dụ: postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require

SECRET_KEY=replace-with-a-long-random-development-secret-key
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Chế độ phân tích AI: auto | required | off
AI_ANALYSIS_MODE=auto
# Thư mục NSFW-Detection/src, tương đối so với backend/
# (để trống sẽ dùng backend/NSFW-Detection/src)
NSFW_PIPELINE_DIR=
# Interpreter chạy pipeline NSFW-Detection (để trống dùng interpreter của backend)
NSFW_PYTHON=
NSFW_TIMEOUT_SECONDS=600
